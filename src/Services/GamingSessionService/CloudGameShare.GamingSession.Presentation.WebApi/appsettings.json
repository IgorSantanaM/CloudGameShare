{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "GamingSessions": "mongodb://localhost:27017/?serverSelectionTimeoutMS=5000"
  },
  "MongoDBSettings": {
    "DatabaseName": "cloudgameshare_sessions"
  },
  "Catalog": {
    "GrpcAddress": "https://localhost:7245"
  },
  "Provisioning": {
    "Namespace": "default",
    "GpuResourceName": "nvidia.com/gpu",
    "ReadinessPort": 8080,
    "ReadinessPath": "/ready",
    "TimeoutSeconds": 600,
    "SessionLifetimeSeconds": 7200
  }
}
